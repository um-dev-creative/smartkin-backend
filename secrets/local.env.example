# Template for secrets/local.env (git-ignored: copy this file there and fill it in).
#
# The ONLY secret docker-compose injects: the token to reach Vault in the first place. Everything else (Supabase, Atlas, Redis, Kafka,
# the backbone and mercury clients, APP_TOKEN_SECRET...) is read from Vault once bootstrap succeeds. Do not add them here: an
# environment variable wins over Vault and would shadow the real value.
#
# In Kubernetes prefer Vault's Kubernetes auth method (the pod's ServiceAccount) over a static token, so there is nothing to
# provision, rotate or leak.

VAULT_TOKEN=

# smartkin-frontend: the secret of its application client in backbone-rest (the other settings are in ../smartkin-frontend/local.env)
BACKBONE_CLIENT_SECRET=
