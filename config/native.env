# Build and smoke-test values for the GraalVM native image (Dockerfile.native). Versioned on purpose: every value is a harmless
# placeholder, never a credential, and none points at real infrastructure.
#
# Why it exists: `spring-boot:process-aot` refreshes the whole application context, so every ${VAR} of application.yml without a default
# must resolve, and at build time there is no Vault or Config Server. These dummies let the context boot far enough for AOT and
# native-image compilation. This is not a deployment configuration: at run time every value comes from Vault / the environment.
#
# Spring AOT bakes the active profiles of the build into the binary, so SPRING_BOOT_PROFILE_ACTIVE is empty on purpose: any value
# here would stay active at run time next to the real one and add a wrong Vault path (the lesson zerobound-rest learned).
#
# Usage: set -a; . config/native.env; set +a; mvn -Pnative -DskipTests package

SPRING_BOOT_PROFILE_ACTIVE=
# Vault and the Config Server are `spring.config.import` sources of application.yml; both are off for the AOT refresh
SPRING_CLOUD_VAULT_ENABLED=false
SPRING_CLOUD_CONFIG_ENABLED=false
SPRING_CLOUD_CONFIG_LABEL=native
VAULT_ENABLED=false
VAULT_TOKEN=unused
VAULT_SERVER_URL=http://vault.invalid
CNFS_URI=http://config-server.invalid
CNFS_PORT=9999
LOGGING_TRACE_ENABLED=false
APP_PORT=8166
# Base64, >= 256 bits (the JWT library decodes it): a build-only placeholder
APP_TOKEN_SECRET=YW90LWJ1aWxkLW9ubHktYW90LWJ1aWxkLW9ubHktYW90LWJ1aWxkLW9ubHktMDEyMzQ1Njc4OQ==
APP_TOKEN_EXPIRATION=3600000

AUTH_SERVER_URI=http://auth.invalid
AUTH_TOKEN_URI=/token
AUTH_CERT_URI=/certs
AUTH_CLIENT_ID=unused
AUTH_CLIENT_SECRET=unused
AUTH_ROLE_ID=none
BACKBONE_GRANT_TYPE=password
BACKBONE_SCOPE=openid
BACKBONE_CLIENT_ID=unused
BACKBONE_CLIENT_SECRET=unused
BACKBONE_USERNAME=unused
BACKBONE_PASSWORD=unused
MERCURY_GRANT_TYPE=password
MERCURY_SCOPE=openid
MERCURY_CLIENT_ID=unused
MERCURY_CLIENT_SECRET=unused
MERCURY_USERNAME=unused
MERCURY_PASSWORD=unused

# Not in application.yml: Vault / the Config Server supply these properties at run time
PRX_BOOTSTRAP_SERVER_URL=localhost
PRX_BOOTSTRAP_SERVER_PORT=9092
PRX_PRODUCER_MERCURY_TOPIC=mercury-email-messages
PRX_VERIFICATION_CODE_TEMPLATE_ID=00000000-0000-4000-8000-000000000001
PRX_SMARTKIN_APPLICATION_ID=00000000-0000-4000-8000-000000000a07
PRX_SMARTKIN_ROLE_ID=00000000-0000-4000-8000-000000000b07

# Never connected to during the build (the AOT refresh does not start lifecycle beans); they only have to be well-formed
SMARTKIN_DB_URI=localhost
SMARTKIN_DB_USERNAME=aot
SMARTKIN_DB_PASSWORD=aot
SMARTKIN_MONGO_SCHEME=mongodb
SMARTKIN_MONGO_HOST=localhost:27017
SMARTKIN_MONGO_USERNAME=aot
SMARTKIN_MONGO_PASSWORD=aot
FLYWAY_ENABLED=false
REVOCATION_ENABLED=false

# The TLS bundle names the real dev keystores copied from certs/smartkin/ onto the classpath
SSL_KEYSTORE_LOCATION=smartkin.jks
SSL_KEYSTORE_PASSWORD=changeit
SSL_KEYSTORE_TYPE=JKS
SSL_TRUSTSTORE_LOCATION=umdc-truststore.jks
SSL_TRUSTSTORE_PASSWORD=changeit
SSL_TRUSTSTORE_TYPE=JKS

# Properties the com.umdc libraries read (Vault / the Config Server supply them at run time)
UMDC_BACKBONE_BASE_URL=backbone.invalid:9999

# spring-cloud-starter-netflix-eureka-client's @RefreshScope "eurekaClient" bean cannot be generated by Spring AOT (a known Spring Cloud
# + native-image gap, not specific to SmartKin; backbone-rest and mercury disable it the same way), and no registry exists at build time
EUREKA_CLIENT_ENABLED=false
