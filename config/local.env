# Non-secret, per-environment startup config for docker-compose. Versioned on purpose (the .gitignore exempts config/*.env):
# nothing in this file is a credential. It only tells smartkin-backend which environment it runs in and how to reach Vault and the
# Config Server, which then supply everything else (Supabase, Atlas, Redis, Kafka, the backbone and mercury clients, JWT secret...).
# Same split as mercury, backbone-rest and zerobound-rest: config/local.env (this file) + secrets/local.env (git-ignored,
# VAULT_TOKEN only).
#
# Do NOT add SMARTKIN_DB_*, SMARTKIN_MONGO_*, REVOCATION_REDIS_URL, APP_TOKEN_SECRET, BACKBONE_*, MERCURY_* or AUTH_* here, not even
# empty: an environment variable wins over Vault and would shadow the real value.

APP_PORT=8166

SPRING_BOOT_PROFILE_ACTIVE=remote-supabase
SPRING_CLOUD_CONFIG_LABEL=Develop

VAULT_ENABLED=true
# Where the secrets live: <VAULT_KV_BACKEND>/<VAULT_KV_CONTEXT>[/<profile>]. Defaults: UMDC and the application name (smartkin-backend).
#VAULT_KV_BACKEND=UMDC
#VAULT_KV_CONTEXT=smartkin-backend
VAULT_SERVER_URL=https://vault.umdc-qa.tst

CNFS_PORT=443
CNFS_URI=https://config-server.umdc-qa.tst

# TLS identity of Tomcat's HTTPS listener (bundle smartkin-security). Not secrets: "changeit" is the placeholder password of the dev
# keystores, and the locations only name the files baked into the jar from certs/smartkin/ (see pom.xml).
SSL_KEYSTORE_LOCATION=smartkin.jks
SSL_KEYSTORE_PASSWORD=changeit
SSL_KEYSTORE_TYPE=JKS
SSL_TRUSTSTORE_LOCATION=umdc-truststore.jks
SSL_TRUSTSTORE_PASSWORD=changeit
SSL_TRUSTSTORE_TYPE=JKS
